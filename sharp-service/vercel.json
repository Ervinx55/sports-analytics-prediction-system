{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "functions": {
    "api/sharp.js": {
      "maxDuration": 30
    },
    "api/dashboard.js": {
      "maxDuration": 30
    },
    "api/nflmodel.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard.html"
    }
  ]
}
