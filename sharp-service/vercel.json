{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "functions": {
    "api/sharp.js": {
      "maxDuration": 30
    },
    "api/dashboard.js": {
      "maxDuration": 30
    },
    "api/nflmodel.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/crypto-candles",
      "destination": "/api/providerstatus?cryptoCandles=1"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "*": false
    }
  }
}
