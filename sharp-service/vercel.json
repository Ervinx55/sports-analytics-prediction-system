{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "functions": {
    "api/sharp.js": {
      "maxDuration": 30
    },
    "api/dashboard.js": {
      "maxDuration": 30
    },
    "api/nflmodel.js": {
      "maxDuration": 30
    },
    "api/models.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/nbamodel", "destination": "/api/models?route=nbamodel" },
    { "source": "/api/nbaprops", "destination": "/api/models?route=nbaprops" },
    { "source": "/api/providerstatus", "destination": "/api/models?route=providerstatus" },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "*": false
    }
  }
}
